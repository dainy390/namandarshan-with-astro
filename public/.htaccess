<IfModule mod_headers.c>
    # Prevent Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent Content Sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Enforce HTTPS (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Content Security Policy (Comprehensive)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com https://accounts.google.com https://www.gstatic.com https://static.cloudflareinsights.com https://*.google.com https://*.googleapis.com https://connect.facebook.net https://appleid.cdn-apple.com; connect-src 'self' https://namandarshan-astrotalk-testing-backend.onrender.com wss://namandarshan-astrotalk-testing-backend.onrender.com http://localhost:5001 ws://localhost:5001 http://52.66.103.126 https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://translate.googleapis.com https://accounts.google.com https://*.googleapis.com https://api.groq.com https://api.dicebear.com https://namandarshan-bucket.s3.ap-south-1.amazonaws.com https://www.facebook.com data:; img-src 'self' data: blob: https: https://res.cloudinary.com https://*.google.com https://api.dicebear.com https://namandarshan-bucket.s3.ap-south-1.amazonaws.com; media-src 'self' blob: data: http://localhost:5001 https://localhost https://namandarshan-bucket.s3.ap-south-1.amazonaws.com https://*.amazonaws.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.gstatic.com https://translate.googleapis.com; font-src 'self' https://fonts.gstatic.com data: https:; frame-src 'self' https://www.googletagmanager.com https://*.googletagmanager.com https://accounts.google.com https://www.youtube.com https://naman-kheel.vercel.app https://cosmic-compass-drab.vercel.app https://www.facebook.com https://appleid.apple.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self';"

    # Cross-Origin Opener Policy (Fix for Google/Facebook Login Popups)
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # Noindex specific page
    SetEnvIf Request_URI "^/elementor-hf/packages-2/?$" noindex_page=1
    Header set X-Robots-Tag "noindex, nofollow" env=noindex_page

    # Noindex robots.txt
    SetEnvIf Request_URI "^/robots\.txt$" noindex_robots=1
    Header set X-Robots-Tag "noindex, nofollow" env=noindex_robots
</IfModule>

# ------------------------------------------------------------------------------
# 0. BASIC WEB APPLICATION FIREWALL (WAF)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Block Suspicious Query Strings (SQLi, XSS, Path Traversal)
  RewriteCond %{QUERY_STRING} (|%3E|%3C)(<|>|'|"|%27|%22)(.*)$ [NC,OR]
  RewriteCond %{QUERY_STRING} (globals|mosconfig|base64_encode|localhost)(.*)$ [NC,OR]
  RewriteCond %{QUERY_STRING} (boot\.ini|etc/passwd|self/environ) [NC,OR]
  RewriteCond %{QUERY_STRING} (\|%7C)([\w\s]+) [NC,OR]
  RewriteCond %{QUERY_STRING} (.)(etc/passwd|/bin/login|/bin/sh|/bin/bash|/bin/csh|/bin/tcsh|/bin/ksh)(.) [NC,OR]
  RewriteCond %{QUERY_STRING} (\<|%3C).script.(\>|%3E) [NC,I,OR]
  RewriteCond %{QUERY_STRING} (javascript:)(.*)(;) [NC,I,OR]
  RewriteCond %{QUERY_STRING} (;|<|>|'|"|\)|%0A|%0D|%22|%27|%3C|%3E|%00).(/\|union|select|insert|cast|set|declare|drop|update|md5|benchmark) [NC,I,OR]
  RewriteCond %{QUERY_STRING} \b(union|insert|cast|set|declare|drop|update|md5|benchmark)\b [NC,I]
  RewriteRule ^(.*)$ - [F,L]

  # Block Common Scanner/Bot User-Agents
  RewriteCond %{HTTP_USER_AGENT} ^.(libwww-perl|curl|wget|python|nikto|scan|sqlmap|nmap). [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} ^$
  RewriteRule ^(.*)$ - [F,L]

  # Block HTTP Request Methods
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|OPTIONS|HEAD) [NC]
  RewriteRule ^.* - [F,L]
</IfModule>

# ------------------------------------------------------------------------------
# 1. PERMANENT 301 REDIRECTS (FOR SEO)
# ------------------------------------------------------------------------------
Options +FollowSymLinks
RewriteEngine On

# Global: Remove trailing slash from URLs (SEO)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ https://namandarshan.com/$1 [L,R=301]

# Sitemap Redirects
Redirect 301 /sitemap_index.xml https://namandarshan.com/sitemap.xml

# Legacy WordPress Cleanup
Redirect 410 /product/
Redirect 404 /author/user/

# Remove old sitemap files
Redirect 404 /ttbm_guide-sitemap.xml
Redirect 404 /ttbm_tour-sitemap.xml
Redirect 404 /page-sitemap.xml
Redirect 404 /category-sitemap.xml
Redirect 404 /post-sitemap.xml
Redirect 404 /ttbm_places-sitemap.xml
Redirect 404 /elementskit_template-sitemap.xml
Redirect 404 /product-sitemap.xml

