    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "https://api.namandarshan.com/sitemap.xml"
        },
        {
            "source": "/sitemap-:slug.xml",
            "destination": "https://api.namandarshan.com/sitemap-:slug.xml"
        },
        {
            "source": "/api/(.*)",
            "destination": "/backend/api/index.js"
        },
        {
            "source": "/ai/(.*)",
            "destination": "/backend/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
