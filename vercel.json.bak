{
    "trailingSlash": false,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://cdn.razorpay.com https://*.razorpay.com https://www.googletagmanager.com https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com https://accounts.google.com https://www.gstatic.com https://static.cloudflareinsights.com https://*.google.com https://*.googleapis.com https://connect.facebook.net https://appleid.cdn-apple.com; connect-src 'self' https://api.namandarshan.com wss://api.namandarshan.com http://localhost:5001 ws://localhost:5001 http://52.66.103.126 https://api.razorpay.com https://lumberjack.razorpay.com https://*.razorpay.com https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://translate.googleapis.com https://accounts.google.com https://*.googleapis.com https://api.groq.com https://api.dicebear.com https://namandarshan-bucket.s3.ap-south-1.amazonaws.com https://www.facebook.com data:; img-src 'self' data: blob: https: https://res.cloudinary.com https://*.google.com https://api.dicebear.com https://namandarshan-bucket.s3.ap-south-1.amazonaws.com; media-src 'self' blob: data: http://localhost:5001 https://localhost https://namandarshan-bucket.s3.ap-south-1.amazonaws.com https://*.amazonaws.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.gstatic.com https://translate.googleapis.com; font-src 'self' https://fonts.gstatic.com data: https:; frame-src 'self' https://www.googletagmanager.com https://*.googletagmanager.com https://accounts.google.com https://www.youtube.com https://naman-kheel.vercel.app https://cosmic-compass-drab.vercel.app https://www.facebook.com https://appleid.apple.com https://checkout.razorpay.com https://api.razorpay.com https://*.razorpay.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self';"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin-allow-popups"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)\\.(webp|jpg|jpeg|png|avif|ico|svg|woff2|woff)$",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)\\.(js|css)$",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/sitemap_index.xml",
            "destination": "/sitemap.xml",
            "permanent": true
        },
        {
            "source": "/product/(.*)",
            "statusCode": 410,
            "destination": "/"
        },
        {
            "source": "/author/user/(.*)",
            "statusCode": 404,
            "destination": "/404"
        },
        {
            "source": "/(.*)-sitemap.xml",
            "statusCode": 404,
            "destination": "/404"
        },
